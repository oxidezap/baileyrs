diff --git a/packages/compiler/test/fs-inputs-experiment.test.ts b/packages/compiler/test/fs-inputs-experiment.test.ts
new file mode 100644
index 000000000..6fe20f078
--- /dev/null
+++ b/packages/compiler/test/fs-inputs-experiment.test.ts
@@ -0,0 +1,47 @@
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { expect, test } from "vitest";
+import { compile, deserializeModule, validateModule } from "../src/index.js";
+
+test("file URL readFileSync and promise rm options lower without discarding arguments", async () => {
+  const dir = await mkdtemp(join(import.meta.dirname, ".fs-inputs-"));
+  try {
+    const entry = join(dir, "main.ts");
+    const outPath = join(dir, "main.ir.json");
+    // Use installed declarations, as a consumer with @types/node does.
+    const types = join(import.meta.dirname, "../../../node_modules/@types");
+    await writeFile(
+      join(dir, "tsconfig.json"),
+      JSON.stringify({
+        compilerOptions: {
+          strict: true,
+          types: ["node"],
+          typeRoots: [types],
+          module: "ESNext",
+          moduleResolution: "Bundler",
+        },
+      }),
+    );
+    await writeFile(
+      entry,
+      `
+import { readFileSync } from "node:fs";
+import { rm } from "node:fs/promises";
+console.log(readFileSync(new URL("./fixture.txt", import.meta.url), "utf8"));
+console.log(readFileSync(new URL("./fixture.txt", import.meta.url)).length);
+await rm("missing", { recursive: true, force: true });
+await rm("missing", { recursive: false, force: true, maxRetries: 2, retryDelay: 10 });
+`,
+    );
+    const result = await compile(entry, { outDir: dir, outPath, outputKind: "ir" });
+    if (!result.ok)
+      throw new Error(result.diagnostics.map((d) => `${d.code}: ${d.message}`).join("\n"));
+    const text = await readFile(outPath, "utf8");
+    expect(validateModule(deserializeModule(text))).toEqual([]);
+    expect(text).toContain("url.fileURLToPathUrl");
+    expect(text).toContain("fsp.rmOpts");
+    expect(text).toContain("fsp.rmRetry");
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
