{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "lib",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": [
    "node_modules",
    "src/**/__tests__/**",
    "src/__fuzz__/**",
    "src/**/*.test.ts",
    "src/**/*.test-e2e.ts"
  ]
}
